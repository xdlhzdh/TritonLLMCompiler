+class AnnotateDotStagesPass
+    : public ::impl::TritonAnnotateDotStagesBase<AnnotateDotStagesPass> {
+public:
+  using ::impl::TritonAnnotateDotStagesBase<AnnotateDotStagesPass>::TritonAnnotateDotStagesBase;
