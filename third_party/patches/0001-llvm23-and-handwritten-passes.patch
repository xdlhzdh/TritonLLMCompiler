+// Same candidate list as python/triton_llm/arch/tiling.py. The last candidate
+// that fits shared memory and the stage cap is the strategy. This is not
+// autotune: one sm maps to one tile.
+struct GemmTile {
+  int64_t blockK;
+  int64_t stages;
+};
+
+GemmTile gemmTileForSm(int32_t sm) {
+  int64_t limit = sm >= 90 ? 228 * 1024 : sm >= 80 ? 164 * 1024 : 96 * 1024;
+  int stagesCap = sm >= 80 ? 3 : 2;
+  struct Cand {
+    int bm, bn, bk, stages;
+  };
+  static constexpr Cand kCands[] = {
+      {64, 64, 32, 2}, {64, 128, 32, 2}, {128, 128, 32, 2},
+      {128, 128, 64, 2}, {128, 128, 64, 3},
+  };
+  GemmTile chosen{32, 2};
+  for (Cand c : kCands) {
+    if (c.stages > stagesCap)
+      continue;
+    int64_t bytes = int64_t(c.stages) * (c.bm * c.bk + c.bn * c.bk) * 2;
+    if (bytes <= limit)
+      chosen = GemmTile{c.bk, c.stages};
+  }
+  return chosen;
+}
