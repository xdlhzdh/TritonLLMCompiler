+class FuseDotEpiloguePass
+    : public ::impl::TritonFuseDotEpilogueBase<FuseDotEpiloguePass> {
+public:
+  void runOnOperation() override {
+    RewritePatternSet patterns(&getContext());
+    patterns.add(+[](arith::MulFOp mul, PatternRewriter &rewriter) -> LogicalResult {
+      Value lhs = mul.getLhs();
+      Value rhs = mul.getRhs();
+      auto dot = lhs.getDefiningOp<DotOp>();
+      Value scale = rhs;
+      if (!dot) {
+        dot = rhs.getDefiningOp<DotOp>();
+        scale = lhs;
+      }
+      if (!dot || !dot.getResult().hasOneUse())
+        return failure();
+      if (scale.getType() != dot.getResult().getType())
+        return failure();
+      auto fused = rewriter.create<FusedDotMulOp>(
+          mul.getLoc(), dot.getResult().getType(), dot.getA(), dot.getB(),
+          dot.getC(), scale);
+      rewriter.replaceOp(mul, fused.getResult());
+      rewriter.eraseOp(dot);
+      return success();
+    });
+    if (failed(applyPatternsGreedily(getOperation(), FrozenRewritePatternSet(std::move(patterns)))))
+      signalPassFailure();
+  }
+};
+
+class LowerFusedDotMulPass
+    : public ::impl::TritonLowerFusedDotMulBase<LowerFusedDotMulPass> {
+public:
+  void runOnOperation() override {
+    RewritePatternSet patterns(&getContext());
+    patterns.add(+[](FusedDotMulOp op, PatternRewriter &rewriter) -> LogicalResult {
+      auto dot = rewriter.create<DotOp>(op.getLoc(), op.getA(), op.getB(), op.getC());
+      auto mul = rewriter.create<arith::MulFOp>(op.getLoc(), dot.getResult(), op.getScale());
+      rewriter.replaceOp(op, mul.getResult());
+      return success();
+    });
+    if (failed(applyPatternsGreedily(getOperation(), FrozenRewritePatternSet(std::move(patterns)))))
+      signalPassFailure();
+  }
+};
+
+class TileDotPass : public ::impl::TritonTileDotBase<TileDotPass> {
+public:
+  using ::impl::TritonTileDotBase<TileDotPass>::TritonTileDotBase;
+
+  void runOnOperation() override {
+    GemmTile tile = gemmTileForSm(targetSm);
+    SmallVector<DotOp> dots;
+    getOperation().walk([&](DotOp dot) { dots.push_back(dot); });
+    for (DotOp dot : dots) {
+      if (failed(tileDot(dot, tile)))
+        continue;
+    }
+  }
+
+  LogicalResult tileDot(DotOp dot, GemmTile tile) {
+    auto aTy = dyn_cast<RankedTensorType>(dot.getA().getType());
+    auto bTy = dyn_cast<RankedTensorType>(dot.getB().getType());
+    auto cTy = dyn_cast<RankedTensorType>(dot.getC().getType());
+    if (!aTy || !bTy || !cTy || aTy.getRank() != 2 || bTy.getRank() != 2)
+      return failure();
+    if (!aTy.hasStaticShape() || !bTy.hasStaticShape())
+      return failure();
+    int64_t m = aTy.getDimSize(0);
+    int64_t k = aTy.getDimSize(1);
+    int64_t kB = bTy.getDimSize(0);
+    int64_t n = bTy.getDimSize(1);
+    if (k != kB || k <= tile.blockK || k % tile.blockK != 0)
+      return failure();
+    if (cTy.getRank() != 2 || cTy.getDimSize(0) != m || cTy.getDimSize(1) != n)
+      return failure();
+
+    OpBuilder builder(dot);
+    Location loc = dot.getLoc();
+    Value lb = builder.create<arith::ConstantIndexOp>(loc, 0);
+    Value ub = builder.create<arith::ConstantIndexOp>(loc, k);
+    Value step = builder.create<arith::ConstantIndexOp>(loc, tile.blockK);
+    auto forOp = builder.create<scf::ForOp>(
+        loc, lb, ub, step, ValueRange{dot.getC()},
+        [&](OpBuilder &b, Location bodyLoc, Value iv, ValueRange iterArgs) {
+          SmallVector<OpFoldResult> strides{b.getIndexAttr(1), b.getIndexAttr(1)};
+          Value aTile = b.create<tensor::ExtractSliceOp>(
+              bodyLoc, dot.getA(),
+              SmallVector<OpFoldResult>{b.getIndexAttr(0), iv},
+              SmallVector<OpFoldResult>{b.getIndexAttr(m), b.getIndexAttr(tile.blockK)},
+              strides);
+          Value bTile = b.create<tensor::ExtractSliceOp>(
+              bodyLoc, dot.getB(),
+              SmallVector<OpFoldResult>{iv, b.getIndexAttr(0)},
+              SmallVector<OpFoldResult>{b.getIndexAttr(tile.blockK), b.getIndexAttr(n)},
+              strides);
+          Value acc = b.create<DotOp>(bodyLoc, aTile, bTile, iterArgs[0]).getResult();
+          b.create<scf::YieldOp>(bodyLoc, acc);
+        });
+    forOp->setAttr("triton_llm.block_k", builder.getI64IntegerAttr(tile.blockK));
+    forOp->setAttr("triton_llm.num_stages", builder.getI64IntegerAttr(tile.stages));
+    dot.replaceAllUsesWith(forOp.getResult(0));
+    dot.erase();
+    return success();
+  }
+};
+
+} // namespace
+
+namespace mlir::triton {
+std::unique_ptr<Pass> createFuseDotEpiloguePass() {
+  return std::make_unique<FuseDotEpiloguePass>();
+}
+std::unique_ptr<Pass> createLowerFusedDotMulPass() {
+  return std::make_unique<LowerFusedDotMulPass>();
+}
+std::unique_ptr<Pass> createTileDotPass(int32_t targetSm) {
+  TritonTileDotOptions options;
+  options.targetSm = targetSm;
+  return std::make_unique<TileDotPass>(options);
+}
+} // namespace mlir::triton
