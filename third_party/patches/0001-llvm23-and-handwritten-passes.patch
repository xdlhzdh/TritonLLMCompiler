+  void runOnOperation() override {
+    int64_t stages = targetSm >= 80 ? 3 : 2;
+    OpBuilder builder(&getContext());
+    IntegerAttr attr = builder.getI64IntegerAttr(stages);
+    getOperation().walk([&](DotOp dot) { dot->setAttr("triton_llm.num_stages", attr); });
