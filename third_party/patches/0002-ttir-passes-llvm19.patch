+namespace mlir {
+namespace triton {
+
+#define GEN_PASS_DEF_TRITONANNOTATEDOTSTAGES
+#include "triton/Dialect/Triton/Transforms/Passes.h.inc"
+
+class AnnotateDotStagesPass
+    : public impl::TritonAnnotateDotStagesBase<AnnotateDotStagesPass> {
+public:
+  using impl::TritonAnnotateDotStagesBase<
+      AnnotateDotStagesPass>::TritonAnnotateDotStagesBase;
+  friend std::unique_ptr<Pass> createAnnotateDotStagesPass(int32_t targetSm);
+
+  void runOnOperation() override {
+    int64_t stages = targetSm >= 80 ? 3 : 2;
+    OpBuilder builder(&getContext());
+    IntegerAttr attr = builder.getI64IntegerAttr(stages);
+    getOperation().walk(
+        [&](DotOp dot) { dot->setAttr("triton_llm.num_stages", attr); });
+  }
+};
+
+std::unique_ptr<Pass> createAnnotateDotStagesPass(int32_t targetSm) {
+  auto pass = std::make_unique<AnnotateDotStagesPass>();
+  pass->targetSm = targetSm;
+  return pass;
+}
