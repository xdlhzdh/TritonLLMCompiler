+// Dot plus a multiplicative epilogue. The scale is applied once, outside any
+// K loop introduced by triton-tile-dot.
+def TT_FusedDotMulOp : TT_Op<"fused_dot_mul", [Pure, AllTypesMatch<["c", "scale", "d"]>]> {
+  let summary = "dot with a multiply epilogue";
+  let arguments = (ins
+    TT_TensorOrMemDesc:$a,
+    TT_TensorOrMemDesc:$b,
+    TT_FpIntTensor:$c,
+    TT_FpIntTensor:$scale
+  );
+  let results = (outs TT_FpIntTensor:$d);
+  let assemblyFormat = [{
+    $a `,` $b `,` $c `,` $scale attr-dict `:`
+    type($a) `*` type($b) `,` type($c) `,` type($scale) `->` type($d)
+  }];
+}
