+#include "triton/Dialect/Triton/Transforms/Passes.h"
+
+namespace mlir {
+namespace triton {
+
+#define GEN_PASS_DEF_TRITONFUSEDOTEPILOGUE
+#define GEN_PASS_DEF_TRITONLOWERFUSEDDOTMUL
+#define GEN_PASS_DEF_TRITONTILEDOT
+#include "triton/Dialect/Triton/Transforms/Passes.h.inc"
+
+// Same candidate list as python/triton_llm/arch/tiling.py. The last candidate
+// that fits shared memory and the stage cap is the strategy.
+struct GemmTile {
+  int64_t blockK;
+  int64_t stages;
+};
+
+GemmTile gemmTileForSm(int32_t sm) {
+  int64_t limit = sm >= 90 ? 228 * 1024 : sm >= 80 ? 164 * 1024 : 96 * 1024;
+  int stagesCap = sm >= 80 ? 3 : 2;
+  struct Cand {
+    int bm, bn, bk, stages;
+  };
+  static constexpr Cand kCands[] = {
+      {64, 64, 32, 2}, {64, 128, 32, 2}, {128, 128, 32, 2},
+      {128, 128, 64, 2}, {128, 128, 64, 3},
+  };
+  GemmTile chosen{32, 2};
+  for (Cand c : kCands) {
+    if (c.stages > stagesCap)
+      continue;
+    int64_t bytes = int64_t(c.stages) * (c.bm * c.bk + c.bn * c.bk) * 2;
+    if (bytes <= limit)
+      chosen = GemmTile{c.bk, c.stages};
+  }
+  return chosen;
+}
+
+struct FuseDotEpiloguePattern : OpRewritePattern<arith::MulFOp> {
+  using OpRewritePattern::OpRewritePattern;
+
+  LogicalResult matchAndRewrite(arith::MulFOp mul,
+                                PatternRewriter &rewriter) const override {
+    Value lhs = mul.getLhs();
+    Value rhs = mul.getRhs();
+    auto dot = lhs.getDefiningOp<DotOp>();
+    Value scale = rhs;
+    if (!dot) {
+      dot = rhs.getDefiningOp<DotOp>();
+      scale = lhs;
+    }
+    if (!dot || !dot.getResult().hasOneUse())
+      return failure();
+    if (scale.getType() != dot.getResult().getType())
+      return failure();
+    auto fused = rewriter.create<FusedDotMulOp>(
+        mul.getLoc(), dot.getResult().getType(), dot.getA(), dot.getB(),
+        dot.getC(), scale);
+    rewriter.replaceOp(mul, fused.getResult());
+    rewriter.eraseOp(dot);
+    return success();
+  }
+};
+
+class FuseDotEpiloguePass
+    : public impl::TritonFuseDotEpilogueBase<FuseDotEpiloguePass> {
+public:
+  using impl::TritonFuseDotEpilogueBase<FuseDotEpiloguePass>::TritonFuseDotEpilogueBase;
+  friend std::unique_ptr<Pass> createFuseDotEpiloguePass();
+
+  void runOnOperation() override {
+    RewritePatternSet patterns(&getContext());
+    patterns.add<FuseDotEpiloguePattern>(&getContext());
+    if (failed(applyPatternsAndFoldGreedily(getOperation(), std::move(patterns))))
+      signalPassFailure();
+  }
+};
+
+struct LowerFusedDotMulPattern : OpRewritePattern<FusedDotMulOp> {
+  using OpRewritePattern::OpRewritePattern;
+
+  LogicalResult matchAndRewrite(FusedDotMulOp op,
+                                PatternRewriter &rewriter) const override {
+    auto dot = rewriter.create<DotOp>(op.getLoc(), op.getA(), op.getB(),
+                                      op.getC(), InputPrecision::IEEE, 0);
+    auto mul = rewriter.create<arith::MulFOp>(op.getLoc(), dot.getResult(),
+                                              op.getScale());
+    rewriter.replaceOp(op, mul.getResult());
+    return success();
+  }
+};
+
+class LowerFusedDotMulPass
+    : public impl::TritonLowerFusedDotMulBase<LowerFusedDotMulPass> {
+public:
+  using impl::TritonLowerFusedDotMulBase<
+      LowerFusedDotMulPass>::TritonLowerFusedDotMulBase;
+  friend std::unique_ptr<Pass> createLowerFusedDotMulPass();
+
+  void runOnOperation() override {
+    RewritePatternSet patterns(&getContext());
+    patterns.add<LowerFusedDotMulPattern>(&getContext());
+    if (failed(applyPatternsAndFoldGreedily(getOperation(), std::move(patterns))))
+      signalPassFailure();
+  }
+};
+
+class TileDotPass : public impl::TritonTileDotBase<TileDotPass> {
+public:
+  using impl::TritonTileDotBase<TileDotPass>::TritonTileDotBase;
+  friend std::unique_ptr<Pass> createTileDotPass(int32_t targetSm);
+
+  void runOnOperation() override {
+    GemmTile tile = gemmTileForSm(targetSm);
+    SmallVector<DotOp> dots;
+    getOperation().walk([&](DotOp dot) { dots.push_back(dot); });
+    for (DotOp dot : dots) {
+      if (failed(tileDot(dot, tile)))
+        continue;
+    }
+  }
+
+  LogicalResult tileDot(DotOp dot, GemmTile tile) {
+    auto aTy = dyn_cast<RankedTensorType>(dot.getA().getType());
+    auto bTy = dyn_cast<RankedTensorType>(dot.getB().getType());
+    auto cTy = dyn_cast<RankedTensorType>(dot.getC().getType());
+    if (!aTy || !bTy || !cTy || aTy.getRank() != 2 || bTy.getRank() != 2)
+      return failure();
+    if (!aTy.hasStaticShape() || !bTy.hasStaticShape())
+      return failure();
+    int64_t m = aTy.getDimSize(0);
+    int64_t k = aTy.getDimSize(1);
+    int64_t kB = bTy.getDimSize(0);
+    int64_t n = bTy.getDimSize(1);
+    if (k != kB || k <= tile.blockK || k % tile.blockK != 0)
+      return failure();
+    if (cTy.getRank() != 2 || cTy.getDimSize(0) != m || cTy.getDimSize(1) != n)
+      return failure();
+
+    OpBuilder builder(dot);
+    Location loc = dot.getLoc();
+    Value lb = builder.create<arith::ConstantIndexOp>(loc, 0);
+    Value ub = builder.create<arith::ConstantIndexOp>(loc, k);
+    Value step = builder.create<arith::ConstantIndexOp>(loc, tile.blockK);
+    auto aTileTy = RankedTensorType::get({m, tile.blockK}, aTy.getElementType());
+    auto bTileTy = RankedTensorType::get({tile.blockK, n}, bTy.getElementType());
+    auto forOp = builder.create<scf::ForOp>(
+        loc, lb, ub, step, ValueRange{dot.getC()},
+        [&](OpBuilder &b, Location bodyLoc, Value iv, ValueRange iterArgs) {
+          SmallVector<OpFoldResult> strides{b.getIndexAttr(1), b.getIndexAttr(1)};
+          Value aTile = b.create<tensor::ExtractSliceOp>(
+              bodyLoc, aTileTy, dot.getA(),
+              SmallVector<OpFoldResult>{b.getIndexAttr(0), iv},
+              SmallVector<OpFoldResult>{b.getIndexAttr(m),
+                                        b.getIndexAttr(tile.blockK)},
+              strides);
+          Value bTile = b.create<tensor::ExtractSliceOp>(
+              bodyLoc, bTileTy, dot.getB(),
+              SmallVector<OpFoldResult>{iv, b.getIndexAttr(0)},
+              SmallVector<OpFoldResult>{b.getIndexAttr(tile.blockK),
+                                        b.getIndexAttr(n)},
+              strides);
+          Value acc = b.create<DotOp>(bodyLoc, aTile, bTile, iterArgs[0],
+                                      InputPrecision::IEEE, 0)
+                          .getResult();
+          b.create<scf::YieldOp>(bodyLoc, acc);
+        });
+    forOp->setAttr("triton_llm.block_k", builder.getI64IntegerAttr(tile.blockK));
+    forOp->setAttr("triton_llm.num_stages", builder.getI64IntegerAttr(tile.stages));
+    dot.replaceAllUsesWith(forOp.getResult(0));
+    dot.erase();
+    return success();
+  }
+};
+
+std::unique_ptr<Pass> createFuseDotEpiloguePass() {
+  return std::make_unique<FuseDotEpiloguePass>();
+}
+std::unique_ptr<Pass> createLowerFusedDotMulPass() {
+  return std::make_unique<LowerFusedDotMulPass>();
+}
+std::unique_ptr<Pass> createTileDotPass(int32_t targetSm) {
+  auto pass = std::make_unique<TileDotPass>();
+  pass->targetSm = targetSm;
+  return pass;
+}
